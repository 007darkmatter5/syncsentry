@page "/Account/Login"
@inject AdminAccountService Accounts

<PageTitle>Log in · SyncSentry</PageTitle>

<div class="acct-wrap">
    <MudText Typo="Typo.h4" GutterBottom="true">Log in</MudText>
    @if (!_hasAccount)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4" Variant="Variant.Outlined">
            This install has no admin yet. Create that account before watching mounts or jobs.
        </MudAlert>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-4">SyncSentry watches rclone and mounts. It does not mount disks or write to media.</MudText>
    }
    @if (Error == "1")
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">The email or password is wrong.</MudAlert>
    }

    <form method="post" action="Account/SignIn" data-enhance="false" class="stack">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <label class="field-label" for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="username" required class="field" />
        <label class="field-label" for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required class="field" />
        <label class="check"><input type="checkbox" name="rememberMe" value="true" /> Remember this browser</label>
        <button type="submit" class="primary">Log in</button>
    </form>

    @if (!_hasAccount)
    {
        <MudText Class="mt-4">
            <MudLink Href="Account/Register">Create the admin account</MudLink>
        </MudText>
    }
</div>

@code {
    private bool _hasAccount;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
        => _hasAccount = await Accounts.HasAccountAsync();
}
