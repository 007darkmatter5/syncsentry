@page "/account/password"

<PageTitle>Password · SyncSentry</PageTitle>

<div class="acct-wrap">
    <MudText Typo="Typo.h4" GutterBottom="true">Password</MudText>
    @if (Ok == "1")
    {
        <MudAlert Severity="Severity.Success" Class="mb-3">Password changed.</MudAlert>
    }
    @if (!string.IsNullOrEmpty(Error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@Error</MudAlert>
    }
    <form method="post" action="Account/ChangePassword" data-enhance="false" class="stack">
        <AntiforgeryToken />
        <label class="field-label" for="current">Current password</label>
        <input id="current" name="current" type="password" autocomplete="current-password" required class="field" />
        <label class="field-label" for="next">New password</label>
        <input id="next" name="next" type="password" autocomplete="new-password" required minlength="8" class="field" />
        <label class="field-label" for="confirm">Confirm</label>
        <input id="confirm" name="confirm" type="password" autocomplete="new-password" required class="field" />
        <button type="submit" class="primary">Change password</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "ok")]
    private string? Ok { get; set; }
}
